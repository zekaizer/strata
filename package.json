{
  "name": "strata",
  "displayName": "Strata",
  "description": "Commit graph for git repositories",
  "version": "0.0.1",
  "publisher": "zekaizer",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zekaizer/strata.git"
  },
  "bugs": {
    "url": "https://github.com/zekaizer/strata/issues"
  },
  "homepage": "https://github.com/zekaizer/strata#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b2230",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.18"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "graph",
    "git graph",
    "git history",
    "history",
    "log",
    "commit",
    "branch",
    "merge",
    "rebase",
    "cherry-pick",
    "stash",
    "tag"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onWebviewPanel:strata.graph",
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "strata.show",
        "title": "Show Commit Graph",
        "category": "Strata",
        "icon": "$(strata-graph)"
      },
      {
        "command": "strata.writeCommitGraph",
        "title": "Write Commit-Graph for Faster History",
        "category": "Strata"
      },
      {
        "command": "strata.switchRepository",
        "title": "Switch Repository...",
        "category": "Strata"
      },
      {
        "command": "strata.openInGraph",
        "title": "Open in Commit Graph",
        "category": "Strata",
        "icon": "$(strata-graph)"
      },
      {
        "command": "strata.showActive",
        "title": "Show Commit Graph for the Active Editor",
        "category": "Strata"
      },
      {
        "command": "strata.showHistory",
        "title": "Show History in Commit Graph",
        "category": "Strata",
        "icon": "$(strata-graph)"
      },
      {
        "command": "strata.showFileHistory",
        "title": "Show File History in Commit Graph",
        "category": "Strata",
        "icon": "$(strata-graph)"
      },
      {
        "command": "strata.file.openChanges",
        "title": "Open Changes",
        "category": "Strata"
      },
      {
        "command": "strata.file.openOld",
        "title": "Open Old Version (Before This Commit)",
        "category": "Strata"
      },
      {
        "command": "strata.file.openNew",
        "title": "Open New Version (As of This Commit)",
        "category": "Strata"
      },
      {
        "command": "strata.file.openToSide",
        "title": "Open to the Side",
        "category": "Strata"
      },
      {
        "command": "strata.file.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Strata"
      },
      {
        "command": "strata.file.copyPath",
        "title": "Copy Path",
        "category": "Strata"
      },
      {
        "command": "strata.file.copyOldRelativePath",
        "title": "Copy Old Relative Path",
        "category": "Strata"
      },
      {
        "command": "strata.file.copyPatch",
        "title": "Copy Patch",
        "category": "Strata"
      },
      {
        "command": "strata.file.showHistory",
        "title": "Show File History",
        "category": "Strata"
      },
      {
        "command": "strata.file.showFolderHistory",
        "title": "Show Folder History",
        "category": "Strata"
      },
      {
        "command": "strata.stash.push",
        "title": "Stash Changes...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.stash.pushUntracked",
        "title": "Stash Changes (Include Untracked)...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.checkout",
        "title": "Checkout",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.checkoutDetached",
        "title": "Checkout (Detached)",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.createBranch",
        "title": "Create Branch...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.createTag",
        "title": "Create Tag...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.cherryPick",
        "title": "Cherry Pick",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.revert",
        "title": "Revert",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.editMessage",
        "title": "Edit Message...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.fixupIntoParent",
        "title": "Fixup into Parent",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.fixupIntoOlder",
        "title": "Fixup into Older Commit...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.dropCommit",
        "title": "Drop Commit...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.squashSelected",
        "title": "Squash Selected Commits...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.dropSelected",
        "title": "Drop Selected Commits...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.copySelectedHashes",
        "title": "Copy Commit Hashes",
        "category": "Strata"
      },
      {
        "command": "strata.merge",
        "title": "Merge into Current Branch...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.rebase",
        "title": "Rebase Current Branch onto This...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.commit.copyHash",
        "title": "Copy Commit Hash",
        "category": "Strata"
      },
      {
        "command": "strata.commit.copyShortHash",
        "title": "Copy Short Commit Hash",
        "category": "Strata"
      },
      {
        "command": "strata.commit.copySubject",
        "title": "Copy Commit Subject",
        "category": "Strata"
      },
      {
        "command": "strata.commit.copyPatch",
        "title": "Copy Patch",
        "category": "Strata"
      },
      {
        "command": "strata.refActions",
        "title": "Branch and Tag Actions...",
        "category": "Strata"
      },
      {
        "command": "strata.reset",
        "title": "Reset Current Branch to Here...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.push",
        "title": "Push",
        "category": "Strata",
        "icon": "$(repo-push)",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.publish",
        "title": "Publish Branch...",
        "category": "Strata",
        "icon": "$(cloud-upload)",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.setUpstream",
        "title": "Set Upstream...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.pull",
        "title": "Pull",
        "category": "Strata",
        "icon": "$(repo-pull)",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.fetch",
        "title": "Fetch From All Remotes",
        "category": "Strata",
        "icon": "$(repo-fetch)",
        "enablement": "!strata.readOnly && !strata.busy"
      },
      {
        "command": "strata.fetchRemote",
        "title": "Fetch Remote",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy"
      },
      {
        "command": "strata.pushTag",
        "title": "Push Tag...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.renameBranch",
        "title": "Rename Branch...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.copyRefName",
        "title": "Copy Name",
        "category": "Strata"
      },
      {
        "command": "strata.hideBadge",
        "title": "Hide Badge",
        "category": "Strata"
      },
      {
        "command": "strata.hideSimilarBadges",
        "title": "Hide Similar Badges...",
        "category": "Strata"
      },
      {
        "command": "strata.deleteBranch",
        "title": "Delete Branch...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.deleteTag",
        "title": "Delete Tag...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.deleteRemoteTag",
        "title": "Delete Remote Tag...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.deleteRemoteBranch",
        "title": "Delete Remote Branch...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.worktree.show",
        "title": "Show Worktree in Graph",
        "category": "Strata"
      },
      {
        "command": "strata.worktree.openNewWindow",
        "title": "Open Worktree in New Window",
        "category": "Strata"
      },
      {
        "command": "strata.worktree.openCurrentWindow",
        "title": "Open Worktree in Current Window",
        "category": "Strata"
      },
      {
        "command": "strata.worktree.reveal",
        "title": "Reveal Worktree in File Explorer",
        "category": "Strata"
      },
      {
        "command": "strata.worktree.copyPath",
        "title": "Copy Worktree Path",
        "category": "Strata"
      },
      {
        "command": "strata.worktree.remove",
        "title": "Remove Worktree...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy"
      },
      {
        "command": "strata.worktree.prune",
        "title": "Prune Worktrees",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy"
      },
      {
        "command": "strata.operation.continue",
        "title": "Continue Operation",
        "category": "Strata",
        "icon": "$(check)",
        "enablement": "!strata.readOnly && !strata.busy"
      },
      {
        "command": "strata.operation.abort",
        "title": "Abort Operation...",
        "category": "Strata",
        "icon": "$(discard)",
        "enablement": "!strata.readOnly && !strata.busy"
      },
      {
        "command": "strata.operation.skip",
        "title": "Skip Commit...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy"
      },
      {
        "command": "strata.stash.apply",
        "title": "Apply Stash",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.stash.pop",
        "title": "Pop Stash",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.stash.branch",
        "title": "Create Branch from Stash...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.stash.copyPatch",
        "title": "Copy Patch",
        "category": "Strata"
      },
      {
        "command": "strata.stash.drop",
        "title": "Drop Stash...",
        "category": "Strata",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.openScm",
        "title": "Open Source Control",
        "category": "Strata"
      },
      {
        "command": "strata.showStashes",
        "title": "Show Stashes...",
        "category": "Strata"
      },
      {
        "command": "strata.goToHead",
        "title": "Go to HEAD",
        "category": "Strata"
      },
      {
        "command": "strata.find",
        "title": "Find Commit...",
        "category": "Strata"
      },
      {
        "command": "strata.saveEdit",
        "title": "Save Commit Message",
        "category": "Strata"
      },
      {
        "command": "strata.resolveConflicts",
        "title": "Resolve Conflicts...",
        "category": "Strata"
      },
      {
        "command": "strata.showStash",
        "title": "Show Stash",
        "category": "Strata"
      },
      {
        "command": "strata.keepStash",
        "title": "Keep Stash",
        "category": "Strata"
      },
      {
        "command": "strata.undo",
        "title": "Undo Last Operation",
        "category": "Strata",
        "icon": "$(discard)",
        "enablement": "!strata.readOnly && !strata.busy && !strata.operation"
      },
      {
        "command": "strata.showOutput",
        "title": "Show Git Output",
        "category": "Strata"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "strata.show",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "strata.openInGraph",
          "when": "scmProvider == git",
          "group": "inline"
        },
        {
          "command": "strata.openInGraph",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "strata.file.openChanges",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file' && strataHasDiff",
          "group": "1_open@1"
        },
        {
          "command": "strata.file.openOld",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file' && strataHasOld",
          "group": "1_open@2"
        },
        {
          "command": "strata.file.openNew",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file' && strataHasNew",
          "group": "1_open@3"
        },
        {
          "command": "strata.file.openToSide",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file'",
          "group": "1_open@4"
        },
        {
          "command": "strata.file.copyRelativePath",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file'",
          "group": "2_copy@1"
        },
        {
          "command": "strata.file.copyPath",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file'",
          "group": "2_copy@2"
        },
        {
          "command": "strata.file.copyOldRelativePath",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file' && strataRenamed",
          "group": "2_copy@3"
        },
        {
          "command": "strata.file.copyPatch",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file'",
          "group": "2_copy@4"
        },
        {
          "command": "strata.file.showHistory",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file'",
          "group": "3_history@1"
        },
        {
          "command": "strata.file.showFolderHistory",
          "when": "webviewId == 'strata.graph' && webviewSection == 'file' && strataInFolder",
          "group": "3_history@2"
        },
        {
          "command": "strata.stash.push",
          "when": "webviewId == 'strata.graph' && webviewSection == 'changes'",
          "group": "1_stash@1"
        },
        {
          "command": "strata.stash.pushUntracked",
          "when": "webviewId == 'strata.graph' && webviewSection == 'changes'",
          "group": "1_stash@2"
        },
        {
          "command": "strata.checkout",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && strataBranch",
          "group": "2_checkout@1"
        },
        {
          "command": "strata.checkout",
          "when": "webviewId == 'strata.graph' && webviewSection == 'branch' && !strataIsCurrent && !strataInWorktree",
          "group": "1_checkout@1"
        },
        {
          "command": "strata.checkout",
          "when": "webviewId == 'strata.graph' && webviewSection == 'remoteBranch'",
          "group": "1_checkout@1"
        },
        {
          "command": "strata.checkoutDetached",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && !strataIsHead",
          "group": "2_checkout@2"
        },
        {
          "command": "strata.checkoutDetached",
          "when": "webviewId == 'strata.graph' && webviewSection == 'tag'",
          "group": "1_checkout@1"
        },
        {
          "command": "strata.createBranch",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit'",
          "group": "2_checkout@3"
        },
        {
          "command": "strata.createBranch",
          "when": "webviewId == 'strata.graph' && webviewSection == 'head'",
          "group": "1_checkout@1"
        },
        {
          "command": "strata.createTag",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit'",
          "group": "2_checkout@4"
        },
        {
          "command": "strata.cherryPick",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && !strataIsHead",
          "group": "3_pick@1"
        },
        {
          "command": "strata.revert",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit'",
          "group": "3_pick@2"
        },
        {
          "command": "strata.editMessage",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && strataRewritable",
          "group": "3_tidy@1"
        },
        {
          "command": "strata.fixupIntoParent",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && strataParentRewritable",
          "group": "3_tidy@2"
        },
        {
          "command": "strata.fixupIntoOlder",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && strataParentRewritable",
          "group": "3_tidy@3"
        },
        {
          "command": "strata.dropCommit",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && strataRewritable",
          "group": "3_tidy@4"
        },
        {
          "command": "strata.squashSelected",
          "when": "webviewId == 'strata.graph' && webviewSection == 'selection'",
          "group": "1_tidy@1"
        },
        {
          "command": "strata.dropSelected",
          "when": "webviewId == 'strata.graph' && webviewSection == 'selection'",
          "group": "1_tidy@2"
        },
        {
          "command": "strata.copySelectedHashes",
          "when": "webviewId == 'strata.graph' && webviewSection == 'selection'",
          "group": "5_copy@1"
        },
        {
          "command": "strata.merge",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && !strataIsHead",
          "group": "4_integrate@1"
        },
        {
          "command": "strata.merge",
          "when": "webviewId == 'strata.graph' && webviewSection == 'branch' && !strataIsCurrent",
          "group": "2_apply@1"
        },
        {
          "command": "strata.merge",
          "when": "webviewId == 'strata.graph' && webviewSection == 'remoteBranch'",
          "group": "2_apply@1"
        },
        {
          "command": "strata.rebase",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && !strataIsHead",
          "group": "4_integrate@2"
        },
        {
          "command": "strata.rebase",
          "when": "webviewId == 'strata.graph' && webviewSection == 'branch' && !strataIsCurrent",
          "group": "2_apply@2"
        },
        {
          "command": "strata.rebase",
          "when": "webviewId == 'strata.graph' && webviewSection == 'remoteBranch'",
          "group": "2_apply@2"
        },
        {
          "command": "strata.commit.copyHash",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit'",
          "group": "5_copy@1"
        },
        {
          "command": "strata.commit.copyShortHash",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit'",
          "group": "5_copy@2"
        },
        {
          "command": "strata.commit.copySubject",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit'",
          "group": "5_copy@3"
        },
        {
          "command": "strata.commit.copyPatch",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit'",
          "group": "5_copy@4"
        },
        {
          "command": "strata.refActions",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && strataHasRefs",
          "group": "2_checkout@5"
        },
        {
          "command": "strata.refActions",
          "when": "webviewId == 'strata.graph' && webviewSection == 'refs'",
          "group": "1_refs@1"
        },
        {
          "command": "strata.reset",
          "when": "webviewId == 'strata.graph' && webviewSection == 'commit' && !strataIsHead",
          "group": "9_reset@1"
        },
        {
          "command": "strata.push",
          "when": "webviewId == 'strata.graph' && webviewSection == 'branch' && strataUpstream",
          "group": "3_remote@2"
        },
        {
          "command": "strata.publish",
