    "configuration": {
      "title": "Strata",
      "properties": {
        "strata.suggestCommitGraph": {
          "type": "boolean",
          "default": true,
          "description": "Offer to write a commit-graph file when a repository without one takes long to show its first page of history, and changed-path filters when the history of a file or folder takes long to search."
        },
        "strata.autoStash": {
          "type": "string",
          "enum": [
            "gitConfig",
            "always",
            "never"
          ],
          "default": "gitConfig",
          "description": "Which choice comes first when a switch would overwrite uncommitted changes: gitConfig and always put stashing them first, never letting git merge them into the target. Operations ask about uncommitted changes only when git can't run over them: a rebase, a merge, pull, cherry pick or revert over changes to the files it changes, and a merge commit, cherry pick or revert over staged changes."
        },
        "strata.columns": {
          "type": "object",
          "properties": {
            "author": {
              "type": "boolean",
              "default": true
            },
            "date": {
              "type": "boolean",
              "default": true
            },
            "hash": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {
            "author": true,
            "date": true,
            "hash": true
          },
          "description": "Which columns the commit rows may show beside the subject. A narrow graph also hides them on its own: the date and then the author while the subject has less than 60 characters of room, the hash only below 30."
        },
        "strata.commitOrder": {
          "type": "string",
          "enum": [
            "topological",
            "date"
          ],
          "enumDescriptions": [
            "Keep the commits of each branch together. The graph stays narrow, and a new commit can move the rows of its whole branch.",
            "List commits by commit date, newest first. A new commit moves no other row, and the graph is wider when branches advance side by side."
          ],
          "default": "topological",
          "description": "The order of the commit rows. A commit is always above its parents."
        },
        "strata.keepCommitGraphUpdated": {
          "type": "boolean",
          "default": false,
          "description": "When the history of a repository that has a commit-graph changes (commits, fetches, rebases, branch changes), add the new commits to the commit-graph in the background (git commit-graph write --reachable --split). Repositories without a commit-graph are left alone."
        }
      }
    },
